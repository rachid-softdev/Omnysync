{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Resolve `@prisma/client` to the shared generated client (same target the
    // typecheck/test configs use) so tsup's dts type-check sees a REAL client.
    // tsup.config.ts lists this shared-dir path in `external` so esbuild keeps
    // `@prisma/client` as a BARE import in the emitted JS (not an inlined
    // relative path), letting the consuming app resolve it from its own
    // generated node_modules copy at next-build time.
    "paths": {
      "@prisma/client": ["../../omnysync-web/prisma/generated/client"]
    }
  }
}
