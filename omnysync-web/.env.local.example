# ==============================================
# OMNYSYNC - Environment Variables
# ==============================================
# Copiez ce fichier vers .env.local et complétez les valeurs

# ---------------- DATABASE ----------------
DATABASE_URL="postgresql://user:password@localhost:5432/omnysync?schema=public"

# ---------------- NEXTAUTH ----------------
NEXTAUTH_SECRET="generer-une-cle-secrete-alea-avec-openssl"
NEXTAUTH_URL="http://localhost:3000"

# ---------------- GOOGLE OAuth ----------------
GOOGLE_CLIENT_ID="votre-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="votre-client-secret"

# ---------------- STRIPE ----------------
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# --------------- RESEND ----------------
RESEND_API_KEY="re_..."

# ---------------- OPENAI ----------------
OPENAI_API_KEY="sk-..."

# ---------------- QSTASH / CRON ----------------
QSTASH_URL="https://qstash.upstash.io"
QSTASH_TOKEN="your-qstash-token"
CRON_SECRET="generate-a-local-secret"

# ---------------- UPSTASH REDIS (optionnel) ----------------
# Identifiants Redis distincts de QStash.
UPSTASH_REDIS_REST_URL="https://your-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-redis-rest-token"

# ---------------- MailHog (dev) ----------------
SMTP_HOST="localhost"
SMTP_PORT="1025"

# ---------------- APP CONFIG ----------------
NODE_ENV="development"