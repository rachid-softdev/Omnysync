{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env", ".env.local"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": []
    },
    "typecheck": {
      // The web app imports @omnysync/core through its package `exports`, which
      // point at dist/ — so the core package must be built before any consumer
      // can be type-checked. (Previously this was worked around with hand-written
      // ambient stubs in omnysync-web/src/types, which silently desynchronised
      // from the real core API.)
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": [],
      "outputs": ["coverage/**"]
    },
    "clean": {
      "cache": false
    },
    "db:generate": {
      "cache": false
    },
    "db:push": {
      "cache": false
    }
  }
}
